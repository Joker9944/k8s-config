{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":dependencyDashboard", "schedule:weekends"],
  // Every Kubernetes manifest is either generated by CUE or written by flux
  // itself, so there is no hand-maintained YAML left for these to read.
  flux: {
    enabled: false,
  },
  "helm-values": {
    enabled: false,
  },
  "pre-commit": {
    enabled: true,
  },
  customManagers: [
    {
      customType: "regex",
      description: "Update versions in yaml files marked by comment",
      managerFilePatterns: [
        "/(?:^|/)talconfig\\.ya?ml$/",
        "/(?:^|/)docker-publish\\.ya?ml$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))? packageName=(?<packageName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s+[\\w-]+: (?<currentValue>.+?)(?:\\s|$)",
      ],
    },
    {
      customType: "regex",
      description: "Update chart and plugin versions in cue files marked by comment",
      managerFilePatterns: ["/\\.cue$/"],
      matchStrings: [
        '\\/\\/ renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))? packageName=(?<packageName>.+?)(?: registryUrl=(?<registryUrl>\\S+?))?(?: versioning=(?<versioning>[a-z-]+?))?\\s+[\\w-]+:\\s+"(?<currentValue>[^"]+)"',
      ],
    },
    {
      customType: "regex",
      description: "Update container images in cue files, which need no comment",
      managerFilePatterns: ["/\\.cue$/"],
      matchStrings: [
        'repository:\\s+"(?<depName>[^"]+)"\\s+tag:\\s+"(?<currentValue>[^"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"',
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Update versions in Dockerfile ARG statements marked by comment",
      managerFilePatterns: ["/(?:^|/)Dockerfile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))? packageName=(?<packageName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\sARG [\\w_]+=(?<currentValue>.+?)(?:\\s|$)",
      ],
    },
  ],
  assignees: ["Joker9944"],
  packageRules: [
    {
      matchUpdateTypes: ["major"],
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },
    {
      matchDatasources: ["docker"],
      matchDepNames: ["talos", "kubelet"],
      automerge: false,
      dependencyDashboardApproval: true,
    },
  ],
}
