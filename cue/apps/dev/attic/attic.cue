package attic

// cSpell:ignore atticd trixie

import (
	"encoding/toml"

	"github.com/joker9944/k8s-config/schema"
)

bundle: schema.#Bundle & {
	namespace: "attic"
	needs: ["object-storage", "postgres"]
	// the only ingress here is served from the tailnet, so no Traefik middleware
	middlewares: false
	extraSecretFiles: ["apps/dev/attic/secrets/attic.secret.yaml"]
	before: [_config.out]
	releases: [_attic]
}

let portHTTP = 8080

// The JWT signing key, the S3 credentials and the database URL are read from
// the environment, so the config holds no secrets.
_config: schema.#ConfigMapFiles & {
	name: "attic-config"
	ns:   bundle.namespace
	files: "server.toml": toml.Marshal({
		listen:         "0.0.0.0:\(portHTTP)"
		"api-endpoint": "https://\(_attic.host)/"
		// url comes from ATTIC_SERVER_DATABASE_URL, but the table must exist
		database: {}
		storage: {
			type:     "s3"
			region:   "nyx"
			bucket:   "attic"
			endpoint: "http://garage.garage.svc.cluster.local:3900"
		}
		// Changing any of these moves the cutpoints, so new NARs stop
		// deduplicating against existing chunks until the old ones age out.
		chunking: {
			"nar-size-threshold": 65536
			"min-size":           16384
			"avg-size":           65536
			"max-size":           262144
		}
		compression: type: "zstd"
		"garbage-collection": {
			interval:                   "12 hours"
			"default-retention-period": "14 days"
		}
	})
}

_attic: schema.#AppRelease & {
	name:      "attic"
	namespace: bundle.namespace

	let uid = 568
	let gid = 568
	let cluster = "\(name)-cnpg"

	// generated by CNPG for the initdb owner
	let appSecret = "\(cluster)-app"

	host:    "attic.\(schema.#TailnetDomain)"
	tailnet: true

	let probe = {
		custom:  true
		enabled: true
		spec: httpGet: {path: "/", port: portHTTP}
	}

	values: {
		controllers: attic: {
			type: "deployment"
			pod: securityContext: {
				runAsUser:           uid
				runAsGroup:          gid
				runAsNonRoot:        true
				fsGroup:             gid
				fsGroupChangePolicy: "OnRootMismatch"
				seccompProfile: type: "RuntimeDefault"
			}
			containers: attic: schema.#Hardened & {
				image: {
					// upstream publishes no versions; main is the only tag tracking a branch
					repository: "ghcr.io/zhaofengli/attic"
					tag:        "main@sha256:18574aba70fc89d2b695273fbe2e7b2f8ad7e8e786b4cc535124fbe14bada1d0"
				}
				args: ["--config", "/config/server.toml"]
				env: ATTIC_SERVER_DATABASE_URL: valueFrom: secretKeyRef: {name: appSecret, key: "uri"}
				envFrom: [{secretRef: name: "attic"}]
				probes: {
					liveness: probe & {spec: failureThreshold: 6}
					readiness: probe
					startup: probe & {spec: {failureThreshold: 30, periodSeconds: 5}}
				}
				resources: {
					requests: {cpu: "100m", memory: "256Mi"}
					limits: memory: "2Gi"
				}
			}

			// blocks startup until the CNPG cluster below is accepting connections
			initContainers: postgresql: schema.#Hardened & {
				image: {
					repository: "ghcr.io/joker9944/postgresql-client"
					tag:        "4.0.0@sha256:10779b6759ea289040d04bda9557ec5906c0658c0ccec58a3fa9c2fdbef674cd"
				}
				env: {
					PGHOST: valueFrom: secretKeyRef: {name: "\(cluster)-app", key: "host"}
					PGUSER: valueFrom: secretKeyRef: {name: "\(cluster)-app", key: "username"}
					PGPASSWORD: valueFrom: secretKeyRef: {name: "\(cluster)-app", key: "password"}
					PGDATABASE: valueFrom: secretKeyRef: {name: "\(cluster)-app", key: "dbname"}
				}
				command: ["/bin/sh", "-c"]
				args: ["""
					echo "Testing connection for DB $PGDATABASE on $PGHOST"
					until
					  pg_isready
					  do sleep 5
					done
					echo "DB $PGDATABASE available on $PGHOST"

					"""]
			}
		}

		service: attic: {
			controller: "attic"
			ports: http: port: portHTTP
		}

		ingress: attic: {
			hosts: [{"host": host, paths: [{path: "/", service: {identifier: "attic", port: "http"}}]}]
			tls: [{hosts: [host]}]
		}

		persistence: {
			config: {
				type: "configMap"
				name: _config.name
				globalMounts: [{path: "/config", readOnly: true}]
			}
			tmp: type: "emptyDir"
		}

		// The index only: the chunks it names are in Garage, and nothing is
		// archived, because the cache is rebuilt rather than restored.
		rawResources: cnpg: manifest: {
			apiVersion: "postgresql.cnpg.io/v1"
			kind:       "Cluster"
			spec: {
				description: "PostgreSQL Cluster for attic"
				instances:   3

				imageCatalogRef: {
					apiGroup: "postgresql.cnpg.io"
					kind:     "ClusterImageCatalog"
					"name":   "postgresql-standard-trixie"
					major:    18
				}

				storage: {size: "2Gi", storageClass: "longhorn-local-strict"}
				walStorage: {size: "2Gi", storageClass: "longhorn-local-strict"}

				bootstrap: initdb: {database: "attic", owner: "attic"}

				affinity: {
					enablePodAntiAffinity: true
					podAntiAffinityType:   "required"
				}
			}
		}
	}
}
