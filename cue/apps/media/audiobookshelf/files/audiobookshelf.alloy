// The audiobookshelf log pipeline. Loaded into alloy's config graph by the
// sidecar that watches ConfigMaps labelled alloy_config; the base config lives
// with alloy and supplies loki.process.common and the target set read below.

discovery.relabel "audiobookshelf" {
	targets = discovery.relabel.k8s_pod_logs.output

	// The claim label the #AlloyPipeline puts on these pods. Carrying it is also
	// what removes them from alloy's generic branch.
	rule {
		source_labels = ["__meta_kubernetes_pod_label_logs_vonarx_online_pipeline"]
		regex         = "audiobookshelf"
		action        = "keep"
	}
}

loki.source.kubernetes "audiobookshelf" {
	targets    = discovery.relabel.audiobookshelf.output
	forward_to = [loki.process.audiobookshelf.receiver]

	clustering {
		enabled = true
	}
}

loki.process "audiobookshelf" {
	forward_to = [loki.process.common.receiver]

	stage.drop {
		expression          = "Received ping"
		drop_counter_reason = "healthcheck_call"
	}

	// Arguments are printed as given, so a pretty-printed object arrives one line
	// per brace.
	stage.multiline {
		firstline = "^\\[\\d{4}-\\d{2}-\\d{2} "
	}

	// Only the level is read: the timestamp is supplied by the container runtime
	// and the message stays in the line, where a filter expression reaches it.
	// Nothing matches to end of record, so neither (?s) nor a `$` anchor applies.
	stage.regex {
		expression = "^\\[[^\\]]+\\] (?P<level>\\w+): "
	}

	// Loki copies `level` into detected_level verbatim, and the global logs
	// dashboard matches that against a lowercase list with a case-sensitive =~.
	stage.template {
		source   = "level"
		template = "{{ ToLower .Value }}"
	}

	stage.structured_metadata {
		values = {
			level = "level",
		}
	}
}
