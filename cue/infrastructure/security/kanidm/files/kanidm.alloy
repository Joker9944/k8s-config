// The kanidm log pipeline. Loaded into alloy's config graph by the sidecar that
// watches ConfigMaps labelled alloy_config; the base config lives with alloy and
// supplies loki.process.common and the labelled target set read below.

// cSpell:ignore kopid

discovery.relabel "kanidm" {
	targets = discovery.relabel.k8s_pod_logs.output

	// The claim label the #AlloyPipeline puts on these pods. Carrying it is also
	// what removes them from alloy's generic branch.
	rule {
		source_labels = ["__meta_kubernetes_pod_label_logs_vonarx_online_pipeline"]
		regex         = "kanidm"
		action        = "keep"
	}
}

loki.source.kubernetes "kanidm" {
	targets    = discovery.relabel.kanidm.output
	forward_to = [loki.process.kanidm.receiver]

	clustering {
		enabled = true
	}
}

loki.process "kanidm" {
	forward_to = [loki.process.common.receiver]

	// One record per kopid: tracing-forest buffers a whole span tree and writes it
	// on span close, so a request's lines are always contiguous and a sequential
	// fold is enough. Root lines carry no box-drawing glyph where children carry
	// `┕━`, `┝━` or `│`, and the whole block is excluded rather than the three
	// glyphs in use so a style change upstream cannot reclassify children.
	//
	// The class has to exclude the space as well. Without it ` +` gives back one
	// pad space, the class matches that, and every child line reads as a root —
	// nothing folds and nothing says so.
	stage.multiline {
		firstline = "^[0-9a-f-]{36} \\w+ +[^ \\x{2500}-\\x{257F}]"
	}

	// After the fold, so a healthcheck tree drops whole rather than orphaning its
	// children onto the record before it.
	stage.drop {
		expression          = "\\| uri: /status \\|"
		drop_counter_reason = "healthcheck_call"
	}

	// tracing-forest pads the level out to a fixed column, so the gap after it is
	// variable — a fixed count fits INFO at depth zero and nothing else. Only the
	// level is read; the kopid, the request's method, uri and status_code are all
	// in the record, where a filter expression reaches them. Nothing matches to
	// end of record, so neither (?s) nor a `$` anchor applies.
	stage.regex {
		expression = "^[0-9a-f-]{36} (?P<level>\\w+)\\s"
	}

	// The level of a folded record is the worst level in it, not the level of its
	// root — an INFO request whose third line is an ERROR is an error, and taking
	// the root's would hide it from the dashboard's filter. Two explicit branches
	// rather than a capture, because a capture takes whichever of ERROR and WARN
	// comes first rather than whichever is worse. The kopid anchor is what stops a
	// message containing the word ERROR from reading as a severity.
	stage.template {
		source   = "level"
		template = "{{ if regexMatch \"(?m)^[0-9a-f-]{36} ERROR\" .Entry }}error{{ else if regexMatch \"(?m)^[0-9a-f-]{36} WARN\" .Entry }}warn{{ else }}{{ ToLower .Value }}{{ end }}"
	}

	stage.structured_metadata {
		values = {
			level = "level",
		}
	}
}
