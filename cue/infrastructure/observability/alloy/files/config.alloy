loki.write "default" {
	endpoint {
		url = "http://loki-gateway.loki.svc.cluster.local/loki/api/v1/push"
	}
}

// Pod logs

discovery.kubernetes "k8s_pod" {
	role = "pod"
}

discovery.relabel "k8s_pod_logs" {
	targets = discovery.kubernetes.k8s_pod.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		action        = "replace"
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		action        = "replace"
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		action        = "replace"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		action        = "replace"
		target_label  = "node"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		action        = "replace"
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
		action        = "replace"
		target_label  = "job"
		separator     = "/"
		replacement   = "$1"
	}
}

// Everything a workload pipeline needs: the standard labels, written once.
// A per-app file reads discovery.relabel.k8s_pod_logs.output and narrows it.

discovery.relabel "k8s_pod_logs_default" {
	targets = discovery.relabel.k8s_pod_logs.output

	// An empty claim label means no workload file has taken this pod, so the
	// generic branch keeps it. This is the only thing that keeps the two branches
	// from shipping the same line twice.
	rule {
		source_labels = ["__meta_kubernetes_pod_label_logs_vonarx_online_pipeline"]
		regex         = ""
		action        = "keep"
	}
}

loki.process "common" {
	forward_to = [loki.write.default.receiver]

	stage.static_labels {
		values = {
			cluster = "nyx",
		}
	}

	// The Kubernetes log API merges stdout and stderr, so the canary's
	// diagnostics would land in the stream it reads back. Every one fails its
	// probe parse and is reported on stderr again — a loop that grows without
	// bound. Only probe lines (`<unix nanos> ppp…`) may enter its stream.
	stage.match {
		selector            = "{job=\"loki/canary\"} !~ \"^[0-9]+ p+[[:space:]]*$\""
		action              = "drop"
		drop_counter_reason = "canary_stderr"
	}

	// loki-canary reads its own lines back with
	// `{job="loki/canary", pod="<its pod name>"}` — the `job` half is its
	// -streamname/-streamvalue, the `pod` value is hardcoded — so the one stream
	// whose `pod` has to stay an index label is this one. A demoted `pod` is not
	// a slow query here but a permanently red canary: the selector would match no
	// stream at all. This selector names `job` too, set in
	// discovery.relabel.k8s_pod_logs and so already present.
	stage.match {
		selector = "{job!=\"loki/canary\"}"

		stage.structured_metadata {
			values = {
				pod  = "pod",
				node = "node",
			}
		}
	}

	// `instance` is the loki.source.* components' own, not a relabel rule, so
	// there is nothing upstream to delete. It arrives as `<namespace>/<pod>:
	// <container>` on a pod branch and as the component id on the events branch;
	// both are concatenations of values already present.
	stage.label_drop {
		values = ["instance"]
	}
}

loki.source.kubernetes "k8s_pod_logs" {
	targets    = discovery.relabel.k8s_pod_logs_default.output
	forward_to = [loki.process.klog.receiver]

	// Discovery is cluster-wide, so without the ring every DaemonSet replica
	// tails every pod and pushes the same lines.
	clustering {
		enabled = true
	}
}

// Cluster events

loki.source.kubernetes_events "k8s_events" {
	forward_to = [loki.process.k8s_events.receiver]

	job_name   = "kubernetes/events"
	log_format = "json"

	// Sharding is per namespace, and `namespaces` is empty: every replica holds
	// the same all-namespaces target, so exactly one of them wins it.
	clustering {
		enabled = true
	}
}
