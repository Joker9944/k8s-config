loki.write "default" {
	endpoint {
		url = "http://loki-gateway.loki.svc.cluster.local/loki/api/v1/push"
	}
}

// Pod logs

discovery.kubernetes "k8s_pod" {
	role = "pod"
}

discovery.relabel "k8s_pod_logs" {
	targets = discovery.kubernetes.k8s_pod.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		action        = "replace"
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		action        = "replace"
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		action        = "replace"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		action        = "replace"
		target_label  = "node"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		action        = "replace"
		target_label  = "app"
	}

	// Escape hatch: longhorn-manager creates its own pods with no label hook, so
	// an unnamed pod in its namespace takes the name its chart pods carry.
	rule {
		source_labels = ["app", "__meta_kubernetes_namespace"]
		regex         = ";longhorn-system"
		action        = "replace"
		target_label  = "app"
		replacement   = "longhorn"
	}

	// Escape hatch: k3s ships its addons from manifests it rewrites on start, so
	// their pods keep the legacy `k8s-app` key.
	rule {
		source_labels = ["app", "__meta_kubernetes_namespace", "__meta_kubernetes_pod_label_k8s_app"]
		regex         = ";kube-system;(.+)"
		action        = "replace"
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
		action        = "replace"
		target_label  = "job"
		separator     = "/"
		replacement   = "$1"
	}
}

// Everything a workload pipeline needs: the standard labels, written once.
// A per-app file reads discovery.relabel.k8s_pod_logs.output and narrows it.

discovery.relabel "k8s_pod_logs_default" {
	targets = discovery.relabel.k8s_pod_logs.output

	// An empty claim label means no workload file has taken this pod, so the
	// generic branch keeps it. This is the only thing that keeps the two branches
	// from shipping the same line twice.
	rule {
		source_labels = ["__meta_kubernetes_pod_label_logs_vonarx_online_pipeline"]
		regex         = ""
		action        = "keep"
	}

	rule {
		source_labels = ["job"]
		regex         = "loki/canary"
		action        = "drop"
	}
}

// loki-canary reads its own lines back with `{stream="stdout", pod=…}`, and
// only the CRI files carry `stream` — the Kubernetes log API merges stdout and
// stderr. Without the split, every diagnostic it read back would fail its probe
// parse and be reported on stderr again. A pod on another node matches no file.
discovery.relabel "canary" {
	targets = discovery.relabel.k8s_pod_logs.output

	rule {
		source_labels = ["job"]
		regex         = "loki/canary"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
		target_label  = "__path__"
		separator     = "/"
		replacement   = "/var/log/pods/*$1/*.log"
	}
}

local.file_match "canary" {
	path_targets = discovery.relabel.canary.output
}

loki.source.file "canary" {
	targets    = local.file_match.canary.targets
	forward_to = [loki.process.canary.receiver]
}

loki.process "canary" {
	forward_to = [loki.process.common.receiver]

	stage.cri { }
}

loki.process "common" {
	forward_to = [loki.write.default.receiver]

	stage.static_labels {
		values = {
			cluster = "nyx",
		}
	}

	// loki-canary's selector names `pod` with a hardcoded value, so its stream
	// keeps `pod` as an index label. A demoted `pod` is not a slow query here but
	// a permanently red canary: the selector would match no stream at all. This
	// selector names `job`, set in discovery.relabel.k8s_pod_logs and so already
	// present.
	stage.match {
		selector = "{job!=\"loki/canary\"}"

		stage.structured_metadata {
			values = {
				pod  = "pod",
				node = "node",
			}
		}
	}

	// `instance` and `filename` are the loki.source.* components' own, not
	// relabel rules, so there is nothing upstream to delete. Both are
	// concatenations of values already present.
	stage.label_drop {
		values = ["filename", "instance"]
	}
}

loki.source.kubernetes "k8s_pod_logs" {
	targets    = discovery.relabel.k8s_pod_logs_default.output
	forward_to = [loki.process.klog.receiver]

	// Discovery is cluster-wide, so without the ring every DaemonSet replica
	// tails every pod and pushes the same lines.
	clustering {
		enabled = true
	}
}

// Cluster events

loki.source.kubernetes_events "k8s_events" {
	forward_to = [loki.process.k8s_events.receiver]

	job_name   = "kubernetes/events"
	log_format = "json"

	// Sharding is per namespace, and `namespaces` is empty: every replica holds
	// the same all-namespaces target, so exactly one of them wins it.
	clustering {
		enabled = true
	}
}
